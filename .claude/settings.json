{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**/*.java)",
      "Read(**/*.xml)",
      "Read(**/*.yml)",
      "Read(**/*.yaml)",
      "Read(**/*.properties)",
      "Read(**/*.json)",
      "Read(**/*.md)",
      "Read(**/*.sql)",
      "Read(build.gradle*)",
      "Read(settings.gradle*)",
      "Read(gradle/**)",
      "Read(gradlew)",
      "Read(gradlew.bat)",
      "Read(.claude/**)",
      "Write(**/*.java)",
      "Write(**/*.xml)",
      "Write(**/*.yml)",
      "Write(**/*.yaml)",
      "Write(**/*.properties)",
      "Write(**/*.json)",
      "Write(**/*.md)",
      "Write(build.gradle*)",
      "Bash(./gradlew *)",
      "Bash(git *)",
      "Bash(java *)",
      "Bash(docker *)",
      "Bash(curl *)"
    ],
    "ask": [
      "Bash(./gradlew bootRun *)",
      "Bash(./gradlew publish*)",
      "Bash(git push *)",
      "Bash(docker push *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(> /dev/sda)"
    ]
  },
  "env": {
    "GRADLE_OPTS": "-Dorg.gradle.daemon=true -Dorg.gradle.parallel=true",
    "SPRING_PROFILES_ACTIVE": "dev"
  },
  "git": {
    "autoCommit": false,
    "commitMessageTemplate": "{{branch}} type(scope): description"
  }
}
